# Copy to .env and fill in. Only required for the POST /briefing endpoint.
# The scoring engine, /districts, /heatmap, /simulate, /investment work without it.
#
# Pick ONE LLM provider (or set both; "auto" prefers Gemini's free tier).
# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: force a provider -> "auto" | "gemini" | "anthropic"
LLM_PROVIDER=auto
